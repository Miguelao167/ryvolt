# ============================================
# RYVOLT COMMUNITY PLATFORM - Environment Variables
# ============================================
# Copie este arquivo para .env.local e preencha com suas credenciais

# ============================================
# SUPABASE
# ============================================
# Vá em: https://supabase.com/dashboard/project/_/settings/api

# URL do projeto (encontrada em Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (encontrada em Settings > API > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (SOMENTE para uso server-side, NUNCA exponha no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ============================================
# APLICAÇÃO
# ============================================

# URL do site (para produção)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta para criptografia de tokens (gere uma string aleatória)
RYVOLT_SECRET_KEY=sua-chave-secreta-minimo-32-caracteres-aqui


# ============================================
# STORAGE (opcional - para uploads)
# ============================================
# Se usar Supabase Storage, as credenciais acima são suficientes


# ============================================
# RATE LIMITING (opcional)
# ============================================
# Limite de requisições por IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000


# ============================================
# LOGGING (opcional)
# ============================================
# Para debugging
# NEXT_PUBLIC_DEBUG_MODE=true
